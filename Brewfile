# Shell and terminal tools
brew "bat" # cat clone with syntax highlighting
brew "eza" # modern ls
brew "fd" # simple find
brew "jq" # JSON processor
brew "neovim" # text editor
brew "peco" # interactive filter
brew "pure" # shell prompt
brew "ripgrep" # fast search tool
brew "tmux" # terminal multiplexer
brew "tree" # directory tree listing

# Git and GitHub
brew "gh" # GitHub CLI
brew "git-delta" # git diff viewer
brew "git-secrets" # prevent committing secrets
brew "lazygit" # TUI git client

# Development toolchains
brew "openjdk" # Java Development Kit
brew "rust" # Rust toolchain
brew "tree-sitter" # parser generator

# Media and documents
brew "ffmpeg" # multimedia toolkit
brew "ghostscript" # PostScript and PDF interpreter
brew "imagemagick" # image processing toolkit
